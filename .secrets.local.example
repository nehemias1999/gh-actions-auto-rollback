# Template for local `act` secrets used by ./tests/integration.sh.
# Copy to `.secrets.local` (git-ignored) and fill in real values:
#   cp .secrets.local.example .secrets.local
# NEVER commit `.secrets.local` or any real token. This file MUST stay
# free of real secrets — placeholders only.

# GitHub token used by act for actions/checkout and API calls.
# Create one at https://github.com/settings/tokens (read-only scopes suffice).
GH_TOKEN=your-github-token-here

# Docker Hub credentials, only needed if the deploy workflow pushes images.
# Leave empty for local-only integration runs.
DOCKERHUB_USERNAME=
DOCKERHUB_PASSWORD=
